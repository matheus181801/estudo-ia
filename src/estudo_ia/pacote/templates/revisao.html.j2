{#- Revisão acumulada de uma matéria do MBA (A5, gabarito no final). -#}
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Revisão — {{ materia }}</title>
<style>
  @page { size: A5; margin: 12mm 11mm 14mm; }
  * { box-sizing: border-box; }
  body { font-family: "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif; color: #1f1b2e; font-size: 11.5pt; line-height: 1.55; margin: 0; }
  h1 { font-size: 21pt; line-height: 1.15; margin: 6px 0 4px; }
  h2 { font-size: 14pt; margin: 0 0 6px; break-after: avoid; }
  p { margin: 0 0 8px; orphans: 3; widows: 3; }
  .capa { background: linear-gradient(135deg, #0f766e, #6d28d9); color: #fff; border-radius: 14px; padding: 18px; }
  .capa small { text-transform: uppercase; letter-spacing: 1px; opacity: .85; font-size: 8pt; }
  .card { border-radius: 12px; padding: 12px 14px; margin-top: 10px; background: #faf8ff; border: 1px solid #ede9fe; }
  .card h2 { color: #0f766e; }
  .quebra { break-before: page; }
  .titulo-parte { font-size: 16pt; color: #0f766e; border-bottom: 3px solid #f59e0b; padding-bottom: 4px; margin: 0 0 10px; }
  .questao { margin-bottom: 12px; break-inside: avoid; }
  .questao .n { display: inline-block; background: #0f766e; color: #fff; border-radius: 6px; padding: 0 7px; font-weight: bold; margin-right: 4px; }
  .questao ol { list-style: upper-alpha; margin: 4px 0 0; padding-left: 24px; }
  .linhas { border-bottom: 1px dashed #99f6e4; height: 22px; }
  .certa { color: #15803d; font-weight: bold; }
  .gabarito .questao { font-size: 10.5pt; }
</style>
</head>
<body>
<div class="capa">
  <small>🎓 MBA · Revisão da matéria · {{ total_aulas }} aula{{ "s" if total_aulas != 1 }} · {{ data_br }}</small>
  <h1>{{ materia }}</h1>
  <div>Tudo o que já foi visto, para provas e trabalhos</div>
</div>

{% for a in r.resumos %}
<div class="card"><h2>📘 {{ a.aula }}</h2>{{ a.essencial | paragrafos }}</div>
{% endfor %}
<div class="card"><h2>🔗 Como as aulas se ligam</h2>{{ r.conexoes | paragrafos }}</div>
<div class="card"><h2>🧩 Glossário da matéria</h2>
  {% for t in r.glossario %}<p><b>{{ t.termo }}</b>: {{ t.explicacao | inline }}</p>{% endfor %}</div>

<div class="quebra"></div>
<h2 class="titulo-parte">📝 Simulado</h2>
{% for q in r.multipla_escolha %}
<div class="questao"><span class="n">{{ loop.index }}</span>{{ q.enunciado | inline }}
  <ol>{% for a in q.alternativas %}<li>{{ a | inline }}</li>{% endfor %}</ol></div>
{% endfor %}
{% for q in r.abertas %}
<div class="questao"><span class="n">{{ r.multipla_escolha | length + loop.index }}</span>{{ q.enunciado | inline }}
  <div class="linhas"></div><div class="linhas"></div><div class="linhas"></div></div>
{% endfor %}

<div class="quebra"></div>
<div class="gabarito">
<h2 class="titulo-parte">🔑 Gabarito comentado</h2>
{% for q in r.multipla_escolha %}
<div class="questao"><span class="n">{{ loop.index }}</span>
  <span class="certa">{{ "ABCD"[q.correta] }}) {{ q.alternativas[q.correta] | inline }}</span><br>{{ q.comentario | inline }}</div>
{% endfor %}
{% for q in r.abertas %}
<div class="questao"><span class="n">{{ r.multipla_escolha | length + loop.index }}</span>{{ q.resposta_esperada | inline }}</div>
{% endfor %}
</div>
</body>
</html>
